# ══════════════════════════════════════════
# 富得財富管理 · 後端環境金鑰範本
# 複製這個檔案，改名為 .env，再填入真實的值
# .env 檔案本身「絕對不要」上傳到 GitHub 或分享出去
# ══════════════════════════════════════════

# ── LINE Messaging API ──
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── Supabase ──
# 注意：SUPABASE_URL 只填「專案網址」本身，不要加 /rest/v1/ 等路徑
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron 保護金鑰（自動產生一組隨機字串即可，用來保護排程端點）──
CRON_SECRET=

# ── Instagram Graph API（富得財富管理官方 IG 自動發文）──
# 取得方式：
#   1. IG 帳號需先切換為「商業帳號」，並連結一個 Facebook 粉絲專頁
#   2. 到 https://developers.facebook.com/ 建立一個 App，新增「Instagram Graph API」產品
#   3. 用 Graph API Explorer 或 System User 產生長效（long-lived）access token，
#      需要 instagram_basic + instagram_content_publish + pages_read_engagement 權限
#   4. IG_BUSINESS_ACCOUNT_ID 是該 IG 商業帳號在 Graph API 裡對應的數字 ID（非帳號名稱）
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
